<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/admin_background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/admin_background">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_idle_lock"
            android:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:background="@drawable/selector_ghost_button"
            android:backgroundTint="@null"
            android:drawableTop="@android:drawable/ic_menu_close_clear_cancel"
            android:drawableTint="@color/white"
            android:focusable="true" />
    </LinearLayout>

    <!-- Navigation Tabs (phone) -->
    <HorizontalScrollView
        android:id="@+id/nav_tabs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <Button
                android:id="@+id/tab_schedule"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_schedule"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_app_limits"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_app_limits"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_dashboard"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_access"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_access"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_settings"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_settings"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_system"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_system"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/tab_about"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/section_about"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_preset_button"
                android:backgroundTint="@null"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Hidden section navigator (compat with TV adapter) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSections"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Main Content -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <!-- Section: Set Time Limit (Dashboard) -->
        <LinearLayout
            android:id="@+id/layout_section_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="visible">

            <TextView
                android:id="@+id/tvRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1:30:00"
                android:textSize="42sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-light"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvLockStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Active"
                android:textColor="@color/admin_text_secondary_light"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btnSetLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_time_limit"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"
                    android:focusable="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/unlock_until_tomorrow"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textColor="@color/white"
                android:background="@drawable/bg_admin_button"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:padding="16dp"
                android:focusable="true" />

        </LinearLayout>

        <!-- Section: Access (Codes) -->
        <ScrollView
            android:id="@+id/layout_section_access"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAccessTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/access_management"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/active_codes"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/generate_codes_label"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etCodeCount"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:hint="@string/qty_hint"
                        android:inputType="number"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_admin_input"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/etMinutesPerCode"
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="wrap_content"
                        android:hint="@string/minutes_hint"
                        android:inputType="number"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_admin_input"
                        android:padding="12dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnGenerateCodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/generate_codes_paid"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true" />

            </LinearLayout>

        </ScrollView>

        <!-- Section: Settings (including PIN) -->
        <ScrollView
            android:id="@+id/layout_section_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_settings"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_pin_label"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etNewPin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_6_digit_pin"
                    android:inputType="numberPassword"
                    android:maxLength="6"
                    android:textColor="@color/white"
                    android:textColorHint="@color/admin_text_secondary"
                    android:background="@drawable/bg_admin_input"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnChangePin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/change_pin"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:layout_marginBottom="24dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/admin_surface"
                    android:layout_marginBottom="24dp" />

                <Switch
                    android:id="@+id/switchAutostart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/autostart_label"
                    android:textColor="@color/white"
                    android:padding="12dp"
                    android:focusable="true"
                    android:background="@drawable/selector_row_background" />

                <Switch
                    android:id="@+id/switchBlocking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_blocking_label"
                    android:textColor="@color/white"
                    android:padding="12dp"
                    android:focusable="true"
                    android:background="@drawable/selector_row_background" />

                <Switch
                    android:id="@+id/switchTimerEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_enabled_label"
                    android:textColor="@color/white"
                    android:padding="12dp"
                    android:focusable="true"
                    android:background="@drawable/selector_row_background" />
            </LinearLayout>
        </ScrollView>

        <!-- Section: System (Permissions) -->
        <ScrollView
            android:id="@+id/layout_section_system"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvSystemTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_system"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_status_placeholder"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/tvAccessibilityInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_instructions"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnOpenAccessibilitySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/accessibility_settings_button"
                    android:layout_marginBottom="16dp"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tvUsageStatsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_stats_status_placeholder"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/tvUsageStatsInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_stats_instructions"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnOpenUsageStatsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/usage_stats_settings_button"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_status_format"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/tvOverlayInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_instructions"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnOpenOverlaySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_settings_button"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/http_enabled_label"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/switchHttpEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Section: About (AGPLv3 compliance) -->
        <ScrollView
            android:id="@+id/layout_section_about"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAboutTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_title"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvAboutVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_version_format"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app_description"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_copyright"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Section: Schedule -->
        <ScrollView
            android:id="@+id/layout_section_schedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvScheduleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_schedule"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/schedule_enabled"
                        android:textColor="@color/white"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/switchScheduleEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_windows_list"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTimeWindows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvNoWindows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_no_windows"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:padding="24dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAddWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule_add_window"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Section: App limits -->
        <ScrollView
            android:id="@+id/layout_section_app_limits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppLimitsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_app_limits"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_limits_independent_hint"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAppLimits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvNoAppLimits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_limits_no_limits"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="15sp"
                    android:textAlignment="center"
                    android:padding="24dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnAddAppLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_limits_add"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Section: Device Admin -->
        <ScrollView
            android:id="@+id/layout_section_device_admin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDeviceAdminTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_system"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvDeviceAdminStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_admin_inactive"
                    android:textColor="@color/admin_text_secondary"
                    android:textSize="15sp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/btnActivateDeviceAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_activate_device_admin"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_admin_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="#CC000000"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>